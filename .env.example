# PostgreSQL (pool primario: registro de dashboards + tablas Meta/GA4 de este repo)
DATABASE_URL=
PG_SSL=false

# DB de server_en_palabras (solo lectura) — fuente de ventas/negocio reales.
# Las named queries marcadas con `-- @db analytics` corren contra esta base.
ANALYTICS_DATABASE_URL=
ANALYTICS_PG_SSL=false

# Meta Ads API
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=

# GA4 (Google Analytics Data API) — service account con rol Lector en la property
GA_PROJECT_ID=
GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_EMAIL=
# La private key va entre comillas; dejá los \n tal cual (el código los convierte)
GA_PRIVATE_KEY=

# Google OAuth (console.cloud.google.com → Credentials → OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
SESSION_SECRET=generate-a-random-string-here

# Server
PORT=3000
